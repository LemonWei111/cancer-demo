# ===== 环境配置示例 =====
# 复制此文件到各子目录的 .env，按注释填写

# ---- 平台 MQ ----
ACPS_MQ_HOST=wt.ioa.pub
ACPS_MQ_PORT=5671
ACPS_MQ_VHOST=acps
ACPS_AUTH_SERVICE_URL=https://wt.ioa.pub:9007

# ---- 证书（必填，各 agent 独立）----
ACPS_CERT_FILE=
ACPS_KEY_FILE=
ACPS_CA_FILE=

# ---- 身份绑定（叮当平台 0，生产建议 1）----
ACPS_IDENTITY_BINDING=0

# ---- Leader ----
ACPS_AIC=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
LEADER_PUBLIC_BASE_URL=http://127.0.0.1:8021
LEADER_AGENT_PORT=8021

# ---- Partner ----
ACPS_PARTNER_AIC=
AGENT_NAME=

# ---- 乳腺模型（不填走默认 ~/BreastCancerCNN-master/...）----
BRCA_GLOBAL_MODEL_PATH=
BRCA_PATCH_MODEL_PATH=

# ---- Kafka AMP ----
KAFKA_BOOTSTRAP_SERVERS=wt.ioa.pub:19092

# ---- 路径（留空走项目根自动推算）----
# UPLOAD_DIR=
# AMP_LOG_DIR=